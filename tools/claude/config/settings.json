{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "cleanupPeriodDays": 30,
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": false,
    "lua-lsp@claude-plugins-official": false
  },
  "feedbackSurveyState": {
    "lastShownTime": 1754054339526
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e \"display notification \\\"Needs your attention in $(basename $PWD)\\\" with title \\\"Claude Code\\\"\""
          }
        ]
      }
    ]
  },
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Agent",
      "TodoWrite",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:code.claude.com)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * +*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/Repos/ooloth/dotfiles/tools/claude/config/settings.json)"
    ],
    "deny": [
      "Bash(git push --force origin main:*)",
      "Bash(git push --force origin master:*)",
      "Bash(git push -f origin main:*)",
      "Bash(git push -f origin master:*)",
      "Bash(git reset --hard origin/main:*)",
      "Bash(git reset --hard origin/master:*)",
      "Bash(op read *)",
      "Bash(op item get *)",
      "Bash(security find-generic-password *)",
      "Bash(security find-internet-password *)",
      "Bash(security dump-keychain*)",
      "Bash(sudo *)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.dev)",
      "Read(./.env.production)",
      "Read(./.env.prod)",
      "Read(./.env.staging)",
      "Read(./.env.stage)",
      "Read(./.env.test)",
      "Read(./.env.ci)",
      "Read(./.env.qa)",
      "Read(./.env.secret)",
      "Read(./.env.secrets)",
      "Read(./.env.vault)",
      "Read(./.env.keys)",
      "Read(./.env.backup)",
      "Read(./.env.bak)",
      "Read(./secrets/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.zshrc)",
      "Edit(~/.zprofile)",
      "Edit(~/.zshenv)",
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.gitconfig)",
      "Edit(~/Library/LaunchAgents/**)",
      "Edit(~/Repos/**/.git/hooks/**)",
      "Edit(~/Repos/**/.git/config)"
    ],
    "defaultMode": "auto"
  },
  "plansDirectory": "./.claude/plans",
  "showClearContextOnPlanAccept": true,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "theme": "dark-daltonized",
  "tui": "fullscreen"
}
