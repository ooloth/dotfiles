{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "cleanupPeriodDays": 30,
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": false,
    "lua-lsp@claude-plugins-official": false
  },
  "env": {
    "CLAUDE_CODE_PACKAGE_MANAGER_AUTO_UPDATE": "1"
  },
  "feedbackSurveyState": {
    "lastShownTime": 1754054339526
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/Repos/ooloth/dotfiles/tools/claude/notify.bash"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Agent",
      "TodoWrite",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:code.claude.com)",
      "mcp__atlassian-rovo__addCommentToJiraIssue",
      "Bash(gh pr comment *)",
      "Bash(gh api repos/recursionpharma/*/pulls/*/comments*)",
      "Bash(jira issue comment add *)",
      "Bash(acli jira workitem view *)",
      "Bash(acli jira workitem comment create *)",
      "Bash(acli jira workitem comment update *)",
      "Skill(commit)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * +*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(acli *--jql*)",
      "Bash(acli *--filter*)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/Repos/ooloth/dotfiles/tools/claude/config/settings.json)",
      "Bash(gh pr merge *)",
      "Bash(uv run *merge-and-verify/scripts/merge.py *)",
      "Edit(~/Repos/ooloth/dotfiles/tools/agents/config/skills/merge-and-verify/scripts/merge.py)",
      "Edit(~/.claude/skills/merge-and-verify/scripts/merge.py)"
    ],
    "deny": [
      "Bash(git push --force origin main:*)",
      "Bash(git push --force origin master:*)",
      "Bash(git push -f origin main:*)",
      "Bash(git push -f origin master:*)",
      "Bash(git reset --hard origin/main:*)",
      "Bash(git reset --hard origin/master:*)",
      "Bash(op read *)",
      "Bash(op item get *)",
      "Bash(security find-generic-password *)",
      "Bash(acli jira workitem comment create *--jql*)",
      "Bash(acli jira workitem comment create *--filter*)",
      "Bash(security find-internet-password *)",
      "Bash(security dump-keychain*)",
      "Bash(sudo *)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.dev)",
      "Read(./.env.production)",
      "Read(./.env.prod)",
      "Read(./.env.staging)",
      "Read(./.env.stage)",
      "Read(./.env.test)",
      "Read(./.env.ci)",
      "Read(./.env.qa)",
      "Read(./.env.secret)",
      "Read(./.env.secrets)",
      "Read(./.env.vault)",
      "Read(./.env.keys)",
      "Read(./.env.backup)",
      "Read(./.env.bak)",
      "Read(./secrets/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.zshrc)",
      "Edit(~/.zprofile)",
      "Edit(~/.zshenv)",
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.gitconfig)",
      "Edit(~/Library/LaunchAgents/**)",
      "Edit(~/Repos/**/.git/hooks/**)",
      "Edit(~/Repos/**/.git/config)"
    ],
    "defaultMode": "auto"
  },
  "plansDirectory": "./.claude/plans",
  "showClearContextOnPlanAccept": true,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 5
  },
  "theme": "dark-daltonized",
  "tui": "fullscreen"
}
