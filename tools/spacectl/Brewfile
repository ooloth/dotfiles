# machine detection — wrap entries in a conditional block to restrict by machine:
#   if computer_name == "Air" ... end
#   if computer_name == "Mini" ... end
#   if ["7385-Y3FH97X-MAC", "MULO-JQ97NW-MBP"].include?(computer_name) ... end
computer_name = `networksetup -getcomputername`.chomp

# Spacelift's CLI, which `auth` checks and logs in with. Homebrew core has no spacectl, and
# Spacelift's tap ships current releases as a cask.
if computer_name == "7385-Y3FH97X-MAC" || computer_name == "MULO-JQ97NW-MBP"
  tap "spacelift-io/spacelift"
  cask "spacelift-io/spacelift/spacectl"
end
