#!/usr/bin/env bash
# Runs the Codefresh CLI from its official Docker image.
#
# Both local installs are broken: the Homebrew tap's packaged binary crashes on startup
# ("Cannot find module '/snapshot/cli/...'"), and the npm package depends on a git fork of firebase,
# which npm 12 refuses to fetch by default. The container gets ~/.cfconfig, read-only, so
# commands that write it (such as `codefresh auth create-context`) fail here. It also gets the
# current directory, read-only and at the same path, so a file argument such as
# `codefresh run ... --yaml build/pipelines/spec.yaml` resolves as it would on the host.
set -euo pipefail

if ! docker info >/dev/null 2>&1; then
  echo "codefresh: Docker isn't running. Start it and try again." >&2
  exit 1
fi

# `logs` prints nothing and never exits without a terminal, so it always gets one. Other
# subcommands get one only when stdout is a terminal, because a terminal ends each line with \r and
# that would corrupt captured output such as `id=$(codefresh run ... --detach)`.
tty_flag=()
if [[ -t 1 || "${1:-}" == logs ]]; then
  tty_flag=(--tty)
fi

# The ${...+...} form keeps an empty array from tripping `set -u` in macOS's bash 3.2
exec docker run --rm ${tty_flag[@]+"${tty_flag[@]}"} \
  --env TZ="${TZ:-$(readlink /etc/localtime | sed 's|.*/zoneinfo/||')}" \
  --volume "${HOME}/.cfconfig:/root/.cfconfig:ro" \
  --volume "${PWD}:${PWD}:ro" \
  --workdir "${PWD}" \
  codefresh/cli "$@"
