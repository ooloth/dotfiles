# see: https://docs.npmjs.com/cli/v10/using-npm/config#npmrc-files
# see: https://docs.npmjs.com/cli/v10/configuring-npm/npmrc

fund = false

# npm 12+ skips install scripts unless the package is listed here, and Claude Code's
# postinstall is what puts its native binary in place (keep in sync with work/.npmrc)
allow-scripts[]=@anthropic-ai/claude-code
