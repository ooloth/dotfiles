#!/usr/bin/env bash
# Prepares a fresh Amp orb (Debian 12) to run this repo's checks: `bash scripts/check.bash`.
# The checks need uv (preinstalled in orbs), shellcheck and lua, the same tools
# .github/workflows/check.yml installs. Safe to rerun: each step skips work that is already done.
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repo}"

SHELLCHECK_VERSION="0.11.0"

step() {
  local name="$1" start=${SECONDS}
  shift
  printf '\n== %s\n' "${name}"
  "$@"
  printf '== %s took %ds\n' "${name}" $((SECONDS - start))
}

# CI installs the latest shellcheck with brew; Debian's is older (0.9.0), so use the release binary
install_shellcheck() {
  if shellcheck --version 2>/dev/null | grep -q "version: ${SHELLCHECK_VERSION}$"; then
    echo "shellcheck ${SHELLCHECK_VERSION} already installed"
    return
  fi
  local tmp
  tmp="$(mktemp -d)"
  curl -fsSL "https://github.com/koalaman/shellcheck/releases/download/v${SHELLCHECK_VERSION}/shellcheck-v${SHELLCHECK_VERSION}.linux.x86_64.tar.xz" |
    tar -xJ -C "${tmp}"
  sudo install -m 0755 "${tmp}/shellcheck-v${SHELLCHECK_VERSION}/shellcheck" /usr/local/bin/shellcheck
  rm -rf "${tmp}"
}

# tools/rex/tests/test_init.py runs init.lua with a bare `lua`, and
# tools/homebrew/tests/test_shell.py runs shell.zsh with `zsh`
install_packages() {
  if command -v lua >/dev/null && command -v zsh >/dev/null; then
    echo "lua and zsh already installed"
    return
  fi
  sudo apt-get update -qq
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq lua5.4 zsh
}

# Amp gives every thread ~/.config/amp/AGENTS.md as guidance, Claude Code threads included, but
# never reads ~/.claude: the agent itself runs outside the orb. So this writes Michael's CLAUDE.md
# into that file, after notes on this orb, between markers it replaces on every run. Text Amp wrote
# before the markers is kept. An earlier version of this script appended only the notes, starting
# at the legacy heading and running to the end of the file, so that is removed too. Amp reads the
# file when a thread starts, so this has to happen in setup rather than in a plugin or resume.
write_agent_guidance() {
  local guidance="${HOME}/.config/amp/AGENTS.md" kept
  local start="<!-- dotfiles: start -->" end="<!-- dotfiles: end -->"
  mkdir -p "$(dirname "${guidance}")"
  touch "${guidance}"
  kept="$(awk -v s="${start}" -v e="${end}" -v legacy="# dotfiles repo in an orb" '
    $0 == s { skip = 1; next }
    skip && $0 == e { skip = 0; next }
    skip { next }
    $0 == legacy { exit }
    { print }' "${guidance}")"
  {
    printf '%s\n\n%s\n\n' "${kept}" "${start}"
    cat <<'NOTES'
# dotfiles repo in an orb

- This orb is Debian Linux; the repo targets macOS and CI runs on macos-latest.
- `bash scripts/check.bash` runs here. Tests that call macOS-only commands, such as
  `/usr/sbin/networksetup` or `defaults`, fail here and pass in CI. Run a failing test on unchanged
  `origin/main` before treating its failure as yours.
- Do not run `symlinks`, `u` or any `link.bash` without a temporary HOME: they write into $HOME.
- What follows is a copy of tools/claude/config/CLAUDE.md, made when this orb was set up. Editing
  that file does not change this copy; a new orb picks up the change once it is pushed.

NOTES
    cat tools/claude/config/CLAUDE.md
    printf '\n%s\n' "${end}"
  } >"${guidance}"
  echo "wrote $(wc -c <"${guidance}") bytes to ${guidance}"
}

# Fill uv's cache with ruff, ty, pytest and every test script's inline dependencies, so the first
# `check` in a new orb doesn't download them. Warm runs only confirm the cache.
warm_uv() {
  # shellcheck source=../scripts/checks/versions.bash
  source scripts/checks/versions.bash
  uv run --quiet --with "ruff==${RUFF_VERSION}" ruff --version
  uv run --quiet --with pytest pytest --version
  env_dir=".cache/check-types-env"
  uv venv --quiet --allow-existing "${env_dir}"
  uv pip install --quiet --python "${env_dir}" "ty==${TY_VERSION}" pytest pyyaml hypothesis
  find tools features scripts -mindepth 3 -maxdepth 3 -path '*/tests/test_*.py' \
    ! -path '*/@new/*' ! -path '*/@archive/*' -print0 |
    xargs -0 -n 1 uv sync --quiet --script
  uv sync --quiet --script scripts/checks/docs.py
  uv sync --quiet --script tools/agents/check-skills.py
}

# Link the shared skills and standards into ~/.agents (and ~/.claude), as `symlinks` does on
# Michael's Macs. Amp reads ~/.agents/skills when a thread starts, Claude Code threads included, and
# skills read ~/.agents/standards/ during a turn. tools/bash/utils.bash expects the repo at
# ~/Repos/ooloth/dotfiles, so that path points at this checkout, and edits here take effect at once.
link_agent_config() {
  local dotfiles="${HOME}/Repos/ooloth/dotfiles"
  if [[ ! -e "${dotfiles}" ]]; then
    mkdir -p "$(dirname "${dotfiles}")"
    ln -s "${repo}" "${dotfiles}"
  fi
  DOTFILES="${dotfiles}" bash tools/agents/link.bash
}

step "shellcheck" install_shellcheck
step "lua and zsh" install_packages
step "uv cache" warm_uv
step "agent guidance" write_agent_guidance
step "agent config" link_agent_config
