# Private values: what tracked files need but must not name, because this repo is public. Copy
# this file to private.env, which git ignores, and fill in the keys this machine reads. Every key
# below is read only on the work laptop. No other machine, Amp orbs included, needs a private.env.
#
# Every new shell, and every bash script started outside one, sources private.env with allexport
# on, so each assignment in it is exported. It is shell code: quote a value that holds spaces. The
# values below are made up.
#
# A token, key or password does not go here, because every process the shell starts would get it.
# Store it with `secret add <name>` instead (see docs/standards/secrets.md).

# read by: tools/gcloud/shell.zsh, as the default gcloud project
PRIVATE_GCLOUD_PROJECT=example-project

# read by: tools/gcloud/shell.zsh, as $DATALAKE and the project `bqq` queries
PRIVATE_BQ_PROJECT=example-datalake-1234

# read by: tools/gcloud/shell.zsh, as $AGGREGATED_MAPS
PRIVATE_BQ_TABLE=example_dataset.example_table

# read by: tools/gcloud/install.bash, for the project of the cluster kubectl connects to
PRIVATE_GKE_PROJECT=example-cluster-1234

# read by: tools/claude/cc.bash, which exports it as ANTHROPIC_VERTEX_PROJECT_ID for every work
# session so the switch in settings.json can move them to Vertex AI, and for a session held on
# Vertex AI (see PRIVATE_VERTEX_ONLY_REPOS and `cc-vertex`), and by `cc-switch` in
# tools/claude/shell.zsh
PRIVATE_VERTEX_PROJECT=example-vertex-1234

# read by: tools/claude/cc.bash, as the space-separated owner/name repos whose sessions always run
# on Vertex AI, whatever the switch in settings.json says. A session is in one when the origin remote
# of the folder it starts in, a checkout, worktree or clone, is that repo. On the work laptop cc.bash
# refuses to start while this key is unset; tools/claude/README.md lists every refusal. Set it to ""
# for no repos.
PRIVATE_VERTEX_ONLY_REPOS="example-org/example-app example-org/example-api"

# read by: tools/uv/install.bash, for the internal uv installer
PRIVATE_UV_INSTALLER_URL=https://internal.example.com/setup-uv.sh

# read by: the use-jira skill and tools/jira/README.md, as the Jira site's hostname
PRIVATE_JIRA_SITE=example.atlassian.net

# read by: the use-jira skill, as the cloudId the Atlassian MCP tools take, and
# tools/agents/config/skills/use-jira/scripts/fetch_jira_backlog.py, for the REST API's gateway URL
PRIVATE_JIRA_CLOUD_ID=00000000-0000-0000-0000-000000000000

# read by: tools/claude/cc.bash, as space-separated FOLDER_PREFIX=RELATED_REPO pairs: a session
# started in a folder whose name starts with FOLDER_PREFIX is told where RELATED_REPO is cloned
PRIVATE_RELATED_REPOS="example-app=example-infra example-infra=example-app"

# read by: features/auth/auth.py, as the Spacelift account `auth` checks and logs in to, the
# subdomain of its <account>.app.spacelift.io URL
PRIVATE_SPACELIFT_ACCOUNT=example

# read by: features/auth/auth.py, as the space-separated Argo CD servers `auth` checks and logs in
# to; after an Argo CD login, the first becomes argocd's default context
PRIVATE_ARGOCD_SERVERS="cd-prod.example.com cd-dev.example.com"

# read by: the use-slack skill, as the check that this is a work machine and the channel every
# Slack search excludes, and by the merge-and-verify, write-progress-update and
# write-review-request skills, as the ID of the user's own channel they post to; without it, no
# Slack tool is called, reads included, because Slack is for work only
PRIVATE_SLACK_REPORT_CHANNEL=C0000000000
