# Private values for this machine: what tracked files need but must not name, because this repo is
# public. Copy this file to private.env, which git ignores, and fill in the keys this machine needs.
#
# Each key has a `# machines:` line naming the machines that need it (air, mini, work) and a
# `# read by:` line naming what reads it. Every new shell names a key this machine needs that
# private.env leaves unset.
#
# The format is one PRIVATE_<NAME>=value per line, with optional quotes around the value. Nothing is
# expanded or run. tools/bash/private-env.bash reads it into the environment, so every checkout of
# the repo sees the same values.
#
# Put only values that would be a leak in a tracked file here. The leak check
# (scripts/checks/private_values.py) fails when a file git does not ignore, or its path, contains
# any word of any value, in any letter case. Words are split on spaces and `=`, so a common word
# here would make it fail everywhere. The values below are made up.

# machines: air mini work
# read by: the leak check, which also fails on these words: names no tool reads, such as internal
# hostnames, private repos and colleagues' handles, separated by spaces
PRIVATE_TERMS="internal.example.com secret-project-name a-colleague"

# machines: work
# read by: tools/gcloud/shell.zsh, as the default gcloud project
PRIVATE_GCLOUD_PROJECT=example-project

# machines: work
# read by: tools/gcloud/shell.zsh, as $DATALAKE and the project `bqq` queries
PRIVATE_BQ_PROJECT=example-datalake-1234

# machines: work
# read by: tools/gcloud/shell.zsh, as $AGGREGATED_MAPS
PRIVATE_BQ_TABLE=example_dataset.example_table

# machines: work
# read by: tools/gcloud/install.bash, for the project of the cluster kubectl connects to
PRIVATE_GKE_PROJECT=example-cluster-1234

# machines: work
# read by: tools/claude/shell.zsh, as the project `ccy-vertex` runs Claude Code on Vertex AI in
PRIVATE_VERTEX_PROJECT=example-vertex-1234

# machines: work
# read by: tools/uv/install.bash and tools/uv/utils.bash, for the internal uv installer
PRIVATE_UV_INSTALLER_URL=https://internal.example.com/setup-uv.sh

# machines: work
# read by: the use-jira skill and tools/jira/README.md, as the Jira site's hostname
PRIVATE_JIRA_SITE=example.atlassian.net

# machines: work
# read by: the use-jira skill, as the cloudId the Atlassian MCP tools take
PRIVATE_JIRA_CLOUD_ID=00000000-0000-0000-0000-000000000000

# machines: work
# read by: tools/claude/cc.bash, as space-separated FOLDER_PREFIX=RELATED_REPO pairs: a session
# started in a folder whose name starts with FOLDER_PREFIX is told where RELATED_REPO is cloned
PRIVATE_RELATED_REPOS="example-app=example-infra example-infra=example-app"
